{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    // "node" is here for `vite.config.ts`, which reads an environment variable
    // to find the API. Application code under `src` has no business touching
    // `process` — that is what `import.meta.env` is for — but `types` is not
    // scoped per file, so this is the cost of typechecking the config at all.
    "types": ["node", "vite/client", "vitest/globals", "@testing-library/jest-dom"],

    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,

    "strict": true,
    // The API can return a key with no value, and indexing a lookup can miss.
    // Both are how bugs of the "undefined is not a function" kind arrive, so
    // the compiler is asked to insist on them rather than assume.
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "vite.config.ts"]
}
