source "https://rubygems.org"

# A series, not a point release. Pinning the exact patch left ruby:3.1.0-slim
# as the only base image that satisfied it — a Debian bullseye build, and
# bullseye left LTS support in August 2026, so its package pool now 404s on
# packages its own index still lists. The container runs 3.1.7 on bookworm,
# this machine runs 3.1.0, and both are the same minor series.
ruby "~> 3.1.0"

gem "rails", "~> 7.1.3", ">= 7.1.3.2"
gem "pg", "~> 1.1"
gem "puma", ">= 5.0"

# Windows does not include zoneinfo files, so bundle the tzinfo-data gem
gem "tzinfo-data", platforms: %i[mswin mswin64 mingw x64_mingw jruby]

# Reduces boot times through caching; required in config/boot.rb
gem "bootsnap", require: false

# The React app is served from a different origin, so the API must opt in to it.
gem "rack-cors"

# Pinned, not chosen. RuboCop depends on `json >= 2.3`, which resolves to 3.x,
# and json 3 dropped the `quirks_mode` keyword that Rails 7.1's JSON encoder
# still passes — so every `render json:` raises ArgumentError. Rails 7.2 fixed
# this; until the upgrade, the constraint has to live here.
gem "json", "~> 2.7"

group :development, :test do
  gem "debug", platforms: %i[mri mswin mswin64 mingw x64_mingw]
  gem "rspec-rails", "~> 6.1"
  gem "factory_bot_rails", "~> 6.4"
end

group :development do
  gem "error_highlight", ">= 0.4.0", platforms: [ :ruby ]

  # Style is enforced by a tool, not by review comments.
  gem "rubocop-rails-omakase", require: false
  gem "rubocop-rspec", require: false
end

group :test do
  # Fails a spec that triggers an N+1 query, so the directory endpoint cannot
  # silently regress into one.
  gem "prosopite"
  gem "pg_query"
end
